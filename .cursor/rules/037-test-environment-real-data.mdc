# Testumgebung mit realen Daten – Fixtures + Separate DBs

**KRITISCH:** Diese Rule ist **PFLICHT** beim Erstellen oder Ändern von Tests. Sie definiert die Testumgebung mit realen Daten-Strukturen.

## Grundprinzip

**Tests verwenden echte Daten-Strukturen:**
- **Unit-Tests:** Fixtures mit realen Daten-Strukturen (schnell, isoliert)
- **Integration-Tests:** Separate Test-Datenbanken mit echten Daten (vollständig, realitätsnah)

## Test-Pyramid

```
┌─────────────────────────────────────┐
│   Integration-Tests (wenige)       │
│   - Separate Test-DBs               │
│   - Reale Daten-Strukturen          │
│   - Vollständiges System            │
├─────────────────────────────────────┤
│   Unit-Tests (viele)                │
│   - Fixtures (docs/ Struktur)       │
│   - In-Memory SQLite (:memory:)     │
│   - Echte Instanzen, keine Mocks    │
└─────────────────────────────────────┘
```

## Fixtures-Struktur

### Fixtures für Unit-Tests

**Pfad:** `__tests__/fixtures/docs/`

**Struktur:**
```
__tests__/
  fixtures/
    docs/
      modules/
        test-module.ts.md
        test-api.ts.md
      adr/
        001-test-adr.md
        002-test-adr.md
      index/
        symbols.jsonl
      system/
        DEPENDENCY_GRAPH.md
        DEPENDENCIES.md
        CHANGE_REPORT.md
    databases/
      test-modules.db
      test-symbols.db
      test-dependencies.db
      test-adrs.db
      test-changes.db
```

### Vorgefertigte Datenbanken

**Pfad:** `__tests__/fixtures/databases/`

**Verwendung:**
- Vorgefertigte SQLite-DBs für schnelle Tests
- Deterministische Test-Daten
- Kein Setup-Overhead

## Unit-Tests: Fixtures

### Fixtures laden

**Pattern:** Fixtures mit realen Daten-Strukturen

```typescript
import * as path from 'path';
import * as fs from 'fs';
import { MultiDbManager } from '../../src/core/multi-db-manager';
import { IngestionOrchestrator } from '../../src/services/ingestion-orchestrator';

describe('Unit Tests with Fixtures', () => {
    let dbManager: MultiDbManager;
    const testWorkspace = path.join(__dirname, '../fixtures/test-workspace');
    const fixturesPath = path.join(__dirname, '../fixtures/docs');

    beforeAll(async () => {
        // Reality-Check: Fixtures existieren
        if (!fs.existsSync(fixturesPath)) {
            throw new Error(`Fixtures not found: ${fixturesPath}`);
        }

        // Erstelle Test-Workspace
        if (!fs.existsSync(testWorkspace)) {
            fs.mkdirSync(testWorkspace, { recursive: true });
        }

        // Kopiere Fixtures nach Test-Workspace
        fs.cpSync(fixturesPath, path.join(testWorkspace, 'docs'), { recursive: true });

        // Erstelle MultiDbManager
        dbManager = new MultiDbManager(testWorkspace);

        // Führe Ingestion mit Fixtures aus
        const orchestrator = new IngestionOrchestrator(dbManager);
        await orchestrator.ingest(testWorkspace, 'test-plugin-id', path.join(testWorkspace, 'docs'));
    });

    afterAll(async () => {
        // Cleanup
        await dbManager.closeAll();
        if (fs.existsSync(testWorkspace)) {
            fs.rmSync(testWorkspace, { recursive: true, force: true });
        }
    });

    it('should load module from fixtures', async () => {
        // Arrange: Fixture-Daten sind bereits geladen
        
        // Act: Query ausführen
        const moduleApi = new ModuleApi(dbManager);
        const module = await moduleApi.getModuleByPath('test-module.ts', 'test-plugin-id');

        // Assert: Fixture-Daten vorhanden
        expect(module).toBeDefined();
        expect(module?.file_path).toBe('test-module.ts');
    });
});
```

### Fixture-Erstellung

**Deterministische Test-Daten:**

```typescript
// __tests__/helpers/test-fixtures.ts

export function createTestModuleFixture(filePath: string, content: string): string {
    return `# Modul: ${filePath}

${content}
`;
}

export function createTestAdrFixture(adrNumber: string, title: string, content: string): string {
    return `# ADR-${adrNumber}: ${title}

## Status

**Accepted** - 2025-01-01

## Kontext

${content}
`;
}

export function createTestSymbolsJsonl(symbols: Array<{symbol_id: string, path: string, name: string}>): string {
    return symbols.map(s => JSON.stringify({
        symbol_id: s.symbol_id,
        path: s.path,
        name: s.name,
        kind: 'function',
        dependencies: []
    })).join('\n');
}
```

## Integration-Tests: Separate DBs

### Separate Test-Datenbanken

**Pattern:** Separate Test-DBs mit echten Daten

```typescript
import * as path from 'path';
import * as fs from 'fs';
import { MultiDbManager } from '../../src/core/multi-db-manager';
import { IngestionOrchestrator } from '../../src/services/ingestion-orchestrator';

describe('Integration Tests with Real Data', () => {
    let dbManager: MultiDbManager;
    const testWorkspace = path.join(__dirname, '../fixtures/test-workspace-integration');
    const realDocsPath = path.join(__dirname, '../../../docs'); // Reale docs/ falls vorhanden

    beforeAll(async () => {
        // Reality-Check: Reale docs/ existieren oder Fixtures nutzen
        const docsPath = fs.existsSync(realDocsPath) ? realDocsPath : path.join(__dirname, '../fixtures/docs');

        // Erstelle Test-Workspace
        if (!fs.existsSync(testWorkspace)) {
            fs.mkdirSync(testWorkspace, { recursive: true });
        }

        // Kopiere reale docs/ oder Fixtures
        if (fs.existsSync(docsPath)) {
            fs.cpSync(docsPath, path.join(testWorkspace, 'docs'), { recursive: true });
        }

        // Erstelle MultiDbManager (separate DBs)
        dbManager = new MultiDbManager(testWorkspace);

        // Führe Ingestion aus
        const orchestrator = new IngestionOrchestrator(dbManager);
        await orchestrator.ingest(testWorkspace, 'test-plugin-id', path.join(testWorkspace, 'docs'));
    });

    afterAll(async () => {
        // Cleanup
        await dbManager.closeAll();
        if (fs.existsSync(testWorkspace)) {
            fs.rmSync(testWorkspace, { recursive: true, force: true });
        }
    });

    it('should work with real data structure', async () => {
        // Arrange: Reale Daten-Strukturen sind geladen
        
        // Act: Vollständige Operation
        const moduleApi = new ModuleApi(dbManager);
        const modules = await moduleApi.getAllModules('test-plugin-id');

        // Assert: Reale Daten-Struktur
        expect(modules.length).toBeGreaterThan(0);
        expect(modules[0].file_path).toMatch(/\.ts$/);
    });
});
```

### Vorgefertigte Datenbanken nutzen

**Pattern:** Schnelle Tests mit vorgefertigten DBs

```typescript
import * as path from 'path';
import * as fs from 'fs';
import { MultiDbManager } from '../../src/core/multi-db-manager';

describe('Tests with Pre-built Databases', () => {
    let dbManager: MultiDbManager;
    const testWorkspace = path.join(__dirname, '../fixtures/test-workspace-prebuild');
    const prebuildDbPath = path.join(__dirname, '../fixtures/databases');

    beforeAll(async () => {
        // Reality-Check: Vorgefertigte DBs existieren
        if (!fs.existsSync(prebuildDbPath)) {
            throw new Error(`Pre-built databases not found: ${prebuildDbPath}`);
        }

        // Erstelle Test-Workspace
        if (!fs.existsSync(testWorkspace)) {
            fs.mkdirSync(testWorkspace, { recursive: true });
        }

        // Kopiere vorgefertigte DBs
        const dbDir = path.join(testWorkspace, '.database-plugin');
        fs.mkdirSync(dbDir, { recursive: true });
        fs.cpSync(prebuildDbPath, dbDir, { recursive: true });

        // Erstelle MultiDbManager (nutzt kopierte DBs)
        dbManager = new MultiDbManager(testWorkspace);
    });

    afterAll(async () => {
        // Cleanup
        await dbManager.closeAll();
        if (fs.existsSync(testWorkspace)) {
            fs.rmSync(testWorkspace, { recursive: true, force: true });
        }
    });

    it('should load from pre-built database', async () => {
        // Arrange: Vorgefertigte DBs sind geladen
        
        // Act: Query ausführen
        const moduleApi = new ModuleApi(dbManager);
        const modules = await moduleApi.getAllModules('test-plugin-id');

        // Assert: Daten aus vorgefertigter DB
        expect(modules.length).toBeGreaterThan(0);
    });
});
```

## Deterministische Test-Daten

### MUST (Pflicht)

- ✅ **Deterministische IDs** - Feste UUIDs, keine `uuidv4()` in Tests
- ✅ **Deterministische Timestamps** - Feste Dates, kein `new Date()` oder `Date.now()`
- ✅ **Deterministische Pfade** - Feste Pfade, keine relativen Pfade die variieren
- ✅ **Deterministische Inhalte** - Feste Strings, kein Random

### MUST NOT (Verboten)

- ❌ **Nicht `uuidv4()` in Tests** - Feste UUIDs verwenden
- ❌ **Nicht `new Date()` in Tests** - Feste Dates verwenden
- ❌ **Nicht `Math.random()` in Tests** - Feste Werte verwenden
- ❌ **Nicht relative Pfade** die variieren können

### Beispiel: Deterministische Test-Daten

```typescript
// ✅ RICHTIG: Deterministische Test-Daten
const testModule = {
    id: '00000000-0000-0000-0000-000000000001',
    plugin_id: 'test-plugin-id',
    file_path: 'test-module.ts',
    content_markdown: '# Test Module\n\nTest content.',
    content_hash: 'test-hash-123',
    created_at: new Date('2025-01-01T00:00:00Z'),
    updated_at: new Date('2025-01-01T00:00:00Z'),
    deleted_at: null
};

// ❌ FALSCH: Nicht-deterministische Test-Daten
const testModule = {
    id: uuidv4(), // Nicht-deterministisch!
    plugin_id: 'test-plugin-id',
    file_path: 'test-module.ts',
    content_markdown: '# Test Module\n\nTest content.',
    content_hash: crypto.createHash('sha256').update('test').digest('hex'), // Nicht-deterministisch wenn Content variiert!
    created_at: new Date(), // Nicht-deterministisch!
    updated_at: new Date(), // Nicht-deterministisch!
    deleted_at: null
};
```

## Fixture-Erstellung: Reale Daten-Struktur

### docs/ Fixtures erstellen

**Pattern:** Reale `docs/` Struktur als Basis

```typescript
// __tests__/helpers/create-fixtures.ts

export async function createDocsFixtures(outputPath: string): Promise<void> {
    const modulesPath = path.join(outputPath, 'modules');
    const adrPath = path.join(outputPath, 'adr');
    const indexPath = path.join(outputPath, 'index');
    const systemPath = path.join(outputPath, 'system');

    // Erstelle Verzeichnisse
    fs.mkdirSync(modulesPath, { recursive: true });
    fs.mkdirSync(adrPath, { recursive: true });
    fs.mkdirSync(indexPath, { recursive: true });
    fs.mkdirSync(systemPath, { recursive: true });

    // Erstelle Test-Module
    fs.writeFileSync(
        path.join(modulesPath, 'test-module.ts.md'),
        createTestModuleFixture('test-module.ts', 'Test module content.')
    );

    // Erstelle Test-ADRs
    fs.writeFileSync(
        path.join(adrPath, '001-test-adr.md'),
        createTestAdrFixture('001', 'Test ADR', 'Test ADR content.')
    );

    // Erstelle Test-Symbols
    fs.writeFileSync(
        path.join(indexPath, 'symbols.jsonl'),
        createTestSymbolsJsonl([
            { symbol_id: 'ts://test-module.ts#testFunction', path: 'test-module.ts', name: 'testFunction' }
        ])
    );

    // Erstelle Test-Dependency-Graph
    fs.writeFileSync(
        path.join(systemPath, 'DEPENDENCY_GRAPH.md'),
        '# Dependency Graph\n\n```mermaid\ngraph TD\n    A[test-module.ts]\n```\n'
    );
}
```

### Vorgefertigte Datenbanken erstellen

**Pattern:** DBs einmalig erstellen, dann kopieren

```typescript
// __tests__/helpers/create-prebuilt-dbs.ts

export async function createPrebuiltDatabases(fixturesPath: string, outputPath: string): Promise<void> {
    const testWorkspace = path.join(__dirname, '../temp-workspace');
    
    // Erstelle temporäres Workspace
    fs.mkdirSync(testWorkspace, { recursive: true });
    fs.cpSync(fixturesPath, path.join(testWorkspace, 'docs'), { recursive: true });

    // Erstelle DBs
    const dbManager = new MultiDbManager(testWorkspace);
    const orchestrator = new IngestionOrchestrator(dbManager);
    await orchestrator.ingest(testWorkspace, 'test-plugin-id', path.join(testWorkspace, 'docs'));

    // Kopiere DBs nach Output-Path
    const dbDir = path.join(testWorkspace, '.database-plugin');
    fs.mkdirSync(outputPath, { recursive: true });
    fs.cpSync(dbDir, outputPath, { recursive: true });

    // Cleanup
    await dbManager.closeAll();
    fs.rmSync(testWorkspace, { recursive: true, force: true });
}
```

## Test-Setup-Patterns

### Pattern 1: Fixtures für Unit-Tests

```typescript
describe('Unit Tests with Fixtures', () => {
    let dbManager: MultiDbManager;
    const testWorkspace = path.join(__dirname, '../fixtures/test-workspace');
    const fixturesPath = path.join(__dirname, '../fixtures/docs');

    beforeAll(async () => {
        // Fixtures kopieren
        fs.cpSync(fixturesPath, path.join(testWorkspace, 'docs'), { recursive: true });

        // Ingestion ausführen
        dbManager = new MultiDbManager(testWorkspace);
        const orchestrator = new IngestionOrchestrator(dbManager);
        await orchestrator.ingest(testWorkspace, 'test-plugin-id', path.join(testWorkspace, 'docs'));
    });

    afterAll(async () => {
        await dbManager.closeAll();
        fs.rmSync(testWorkspace, { recursive: true, force: true });
    });

    // Tests...
});
```

